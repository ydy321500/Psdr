<Window x:Class="FastReportWpfProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastReport WPF 兼容性验证" Height="230" Width="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="使用新版程序中的 FastReport 2018.3.13 DLL，验证设计器与预览窗口。"
                   TextWrapping="Wrap" />
        <TextBox x:Name="TemplatePath" Grid.Row="1" Margin="0,18,0,18"
                 ToolTip="用于预览的 .frx 模板完整路径" />
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="打开空白设计器" Width="135" Margin="0,0,12,0"
                    Click="OpenDesigner_Click" />
            <Button Content="预览指定模板" Width="125" Click="Preview_Click" />
        </StackPanel>
    </Grid>
</Window>
