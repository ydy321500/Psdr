<Window x:Class="Psdr.Admin.Views.AgentManagement.AdminLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="PSDR 管理日志" Width="980" Height="620" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/Psdr.UI;component/Themes/Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource CanvasBrush}"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid><TextBlock Text="PSDR · 管理日志" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,0,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{DynamicResource TitleBarButtonStyle}" Content="↻" Command="{Binding RefreshCommand}" ToolTip="刷新" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><Button Style="{DynamicResource CloseTitleBarButtonStyle}" Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="关闭" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Data="{StaticResource CloseIconGeometry}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform"/></Button></StackPanel></Grid></Border>
        <Border Grid.Row="1" Margin="22" Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding LogTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="170"/><DataGridTextColumn Header="用户" Binding="{Binding UserName}" Width="*"/><DataGridTextColumn Header="机器" Binding="{Binding MachineInfo}" Width="*"/><DataGridTextColumn Header="事件" Binding="{Binding Event}" Width="2*"/><DataGridTextColumn Header="信息" Binding="{Binding Info}" Width="2*"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}"/></Grid></Border>
    </Grid>
</Window>
