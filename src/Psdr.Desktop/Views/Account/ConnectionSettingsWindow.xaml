<Window x:Class="Psdr.Desktop.Views.Account.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="代理设置" Width="430" Height="280" MinWidth="430" MinHeight="264"
        MaxWidth="430" MaxHeight="264" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" Background="White">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Panel.ZIndex="10" Style="{DynamicResource DialogOutlineStyle}" />
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="代理设置" Margin="22,0,0,0" VerticalAlignment="Center"
                           Foreground="#263F58" FontSize="15" FontWeight="SemiBold" />
                <Button HorizontalAlignment="Right" Margin="0,3,8,3"
                        Style="{DynamicResource LightWindowButtonStyle}" Content="×" FontSize="20"
                        Command="{Binding CancelCommand}" ToolTip="关闭"
                        AutomationProperties.AutomationId="SettingsClose"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="26,23,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>
            <TextBlock Text="请输入分配给您的代理号" FontSize="16" FontWeight="SemiBold"
                       Foreground="#213B54" />
            <TextBlock Grid.Row="2" Text="代理号" Style="{DynamicResource LoginFieldLabelStyle}" />
            <TextBox Grid.Row="3" Margin="0,5,0,0"
                     Text="{Binding AgentNo, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource LoginTextBoxStyle}" Height="40"
                     AutomationProperties.AutomationId="SettingsAgentNo" />
            <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,10,0,0"
                       FontSize="12" Foreground="#C9434D" />
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="94" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="94" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="保存" Style="{DynamicResource LoginPrimaryButtonStyle}"
                        Command="{Binding SaveCommand}" IsDefault="True"
                        AutomationProperties.AutomationId="SettingsSave" />
                <Button Grid.Column="3" Content="取消" Style="{DynamicResource LoginSecondaryButtonStyle}"
                        Command="{Binding CancelCommand}" IsCancel="True"
                        AutomationProperties.AutomationId="SettingsCancel" />
            </Grid>
        </Grid>
    </Grid>
</Window>
