<Window x:Class="Psdr.Desktop.Views.Account.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:behaviors="clr-namespace:Psdr.UI.Behaviors;assembly=Psdr.UI"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="登录 · 进销存红包系统" Width="920" Height="538"
        MinWidth="920" MinHeight="538" MaxWidth="920" MaxHeight="538"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource LoginBackdropBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="354" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="2" Grid.RowSpan="2" Panel.ZIndex="10"
                Style="{DynamicResource DialogOutlineStyle}" />

        <Border Grid.Column="0" Grid.RowSpan="2" ClipToBounds="True">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="White" Offset="0" />
                    <GradientStop Color="White" Offset="0.72" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Border.OpacityMask>
            <Image Source="/Psdr.Desktop;component/Assets/login-warehouse.png"
                   Stretch="UniformToFill" SnapsToDevicePixels="True">
                <Image.RenderTransform>
                    <TranslateTransform X="-12" />
                </Image.RenderTransform>
            </Image>
        </Border>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Panel.ZIndex="2">
            <TextBlock Text="PSDR" Margin="18,0,0,0" VerticalAlignment="Center"
                       Foreground="#D3E2EF" FontSize="12" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,7,3">
                <Button Style="{DynamicResource LoginWindowButtonStyle}" Content="─"
                        Command="{Binding MinimizeCommand}" ToolTip="最小化"
                        AutomationProperties.AutomationId="LoginMinimize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Style="{DynamicResource LoginWindowButtonStyle}" Content="×" FontSize="20"
                        Command="{Binding CloseCommand}" ToolTip="关闭"
                        AutomationProperties.AutomationId="LoginClose"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Grid.RowSpan="2" Margin="48" Panel.ZIndex="1"
                Style="{DynamicResource LoginCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="94" />
                    <RowDefinition Height="66" />
                    <RowDefinition Height="66" />
                    <RowDefinition Height="31" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="43" />
                    <RowDefinition Height="45" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="35" Height="35" CornerRadius="18"
                            BorderThickness="1" BorderBrush="#B9CDE0"
                            Background="#F2F7FC" HorizontalAlignment="Center">
                        <TextBlock Text="P" Foreground="#274968" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="进销存红包系统" TextAlignment="Center" Foreground="#203B55"
                               FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="登录业务管理平台" TextAlignment="Center" Foreground="#8296A9"
                               FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
 
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="账号" Style="{DynamicResource LoginFieldLabelStyle}" />
                    <TextBox x:Name="UserCodeBox" Grid.Row="1"
                             Text="{Binding UserCode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource LoginTextBoxStyle}"
                             VerticalContentAlignment="Center" Padding="12,0"
                             AutomationProperties.Name="账号" AutomationProperties.AutomationId="LoginUserCode" />
                </Grid>
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="密码" Style="{DynamicResource LoginFieldLabelStyle}" />
                    <PasswordBox Grid.Row="1" behaviors:SecurePasswordBinding.IsEnabled="True"
                                 behaviors:SecurePasswordBinding.Password="{Binding Password, Mode=TwoWay}"
                                 Style="{DynamicResource LoginPasswordBoxStyle}"
                                 VerticalContentAlignment="Center" Padding="12,0" Height="40"
                                 AutomationProperties.Name="密码" AutomationProperties.AutomationId="LoginPassword" />
                </Grid>
                <CheckBox Grid.Row="3" Content="记住账号" IsChecked="{Binding RememberAccount}"
                          VerticalAlignment="Center" FontSize="13"
                          AutomationProperties.AutomationId="RememberAccount" />
                <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="#C9434D" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="登 录" Style="{DynamicResource LoginPrimaryButtonStyle}"
                            Command="{Binding LoginCommand}" IsDefault="True"
                            AutomationProperties.AutomationId="LoginSubmit" />
                    <Button Grid.Column="2" Content="退出" Style="{DynamicResource LoginSecondaryButtonStyle}"
                            Command="{Binding CloseCommand}" IsCancel="True"
                            AutomationProperties.AutomationId="LoginExit" />
                </Grid>
                <Button Grid.Row="7" Content="代理设置" Style="{DynamicResource LoginLinkButtonStyle}"
                       HorizontalAlignment="Center" Command="{Binding OpenSettingsCommand}"
                        VerticalAlignment="Bottom"
                       AutomationProperties.AutomationId="LoginSettings" />
            </Grid>
        </Border>
    </Grid>
</Window>
