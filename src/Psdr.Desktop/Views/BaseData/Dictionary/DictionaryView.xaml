<UserControl xmlns:dialog="clr-namespace:Psdr.UI.Behaviors;assembly=Psdr.UI" x:Class="Psdr.Desktop.Views.BaseData.Dictionary.DictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="字典维护" Style="{DynamicResource PageTitleTextStyle}" />
                    <TextBlock Text="管理产品属性选项和业务字典内容" Margin="0,5,0,0"
                               Style="{DynamicResource SecondaryTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="＋ 新增字典" Command="{Binding NewCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource ContentCardStyle}" Padding="20"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="12" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="产品类型" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Products}" DisplayMemberPath="FunctionName"
                                  SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" />
                        <Button Grid.Column="3" Content="刷新" Command="{Binding RefreshCommand}" />
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Entries}" MaxHeight="520"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                              IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编号" Binding="{Binding Data.DicID}" Width="75" />
                            <DataGridTextColumn Header="类别" Binding="{Binding Data.DicModel}" Width="95" />
                            <DataGridTextColumn Header="属性" Binding="{Binding DisplayName}" Width="2*" />
                            <DataGridTextColumn Header="内容" Binding="{Binding Data.DicValue}" Width="3*" />
                            <DataGridTemplateColumn Header="操作" Width="126"
                                                    CellTemplate="{StaticResource RecordEditDeleteTemplate}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource ContentCardStyle}" Padding="22"
                    Width="320" Margin="16,0,0,0"
                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibility}}" dialog:EditorDialog.IsOpen="{Binding IsEditing}" dialog:EditorDialog.Title="字典资料" dialog:EditorDialog.CancelCommand="{Binding CancelCommand}">
                <StackPanel>
                    <TextBlock Text="字典设置" Style="{DynamicResource PageTitleTextStyle}" />
                    <TextBlock Text="产品字典关联已启用的产品属性；业务字典可输入自定义名称。"
                               Margin="0,14,0,0" TextWrapping="Wrap"
                               Style="{DynamicResource SecondaryTextStyle}" />
                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="类别" Margin="0,20,0,7" />
                        <ComboBox SelectedValue="{Binding EditorModel, Mode=TwoWay}" SelectedValuePath="Content">
                            <ComboBoxItem Content="产品" /><ComboBoxItem Content="业务" />
                        </ComboBox>
                        <StackPanel Visibility="{Binding IsProductModel, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="产品属性" Margin="0,16,0,7" />
                            <ComboBox ItemsSource="{Binding Attributes}" DisplayMemberPath="ValueName"
                                      SelectedItem="{Binding SelectedAttribute, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsBusinessModel, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="业务名称" Margin="0,16,0,7" />
                            <TextBox Text="{Binding EditorBusinessName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <TextBlock Text="内容" Margin="0,16,0,7" />
                        <TextBox Text="{Binding EditorValue, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Content="保存" Command="{Binding SaveCommand}"
                                    Style="{DynamicResource PrimaryButtonStyle}" />
                            <Button Content="取消" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
