<UserControl x:Class="Psdr.Desktop.Views.BaseData.Product.BarCodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="条码生成" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="沿用新版 PSDR 的明码、暗码计算规则；生成后立即写入条码登记表。" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel>
                <Button Grid.Column="1" Content="刷新序号" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="下一个序号"/><TextBlock Text="{Binding NextIndexText}" Margin="0,7,0,0" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="明码前缀（可选）"/><TextBox Text="{Binding ClearCodePrefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" ToolTip="例如移动端访问地址；为空时仅生成条码本体"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="18,0,0,0"><TextBlock Text="生成数量 *"/><TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0"/></StackPanel>
                <Button Grid.Column="4" Content="生成条码" Command="{Binding GenerateCommand}" Style="{DynamicResource PrimaryButtonStyle}" Margin="18,20,0,0" VerticalAlignment="Bottom"/>
            </Grid></Border>
            <Border Grid.Row="2" Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="本次生成结果" Style="{DynamicResource SectionTitleTextStyle}"/><Button Grid.Column="1" Content="导出 CSV" Command="{Binding ExportCommand}"/></Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="序号" Binding="{Binding IndexNo}" Width="120"/><DataGridTextColumn Header="明码" Binding="{Binding ClearCode}" Width="2*"/><DataGridTextColumn Header="暗码" Binding="{Binding SecretCode}" Width="2*"/></DataGrid.Columns></DataGrid>
                <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
            </Grid></Border>
        </Grid>
    </Grid>
</UserControl>
