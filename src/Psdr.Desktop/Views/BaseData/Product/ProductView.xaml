<UserControl xmlns:dialog="clr-namespace:Psdr.UI.Behaviors;assembly=Psdr.UI" x:Class="Psdr.Desktop.Views.BaseData.Product.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="产品资料" Style="{DynamicResource PageTitleTextStyle}" />
                    <TextBlock Text="按已启用的产品类型和属性定义维护产品资料" Margin="0,5,0,0"
                               Style="{DynamicResource SecondaryTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="＋ 新增产品" Command="{Binding NewCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Style="{DynamicResource ContentCardStyle}" Padding="20" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="按产品类型、属性或库位筛选" />
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="520">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编号" Binding="{Binding ProductID}" Width="70" />
                            <DataGridTextColumn Header="产品类型" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="属性 1" Binding="{Binding K1}" Width="*" />
                            <DataGridTextColumn Header="属性 2" Binding="{Binding K2}" Width="*" />
                            <DataGridTextColumn Header="进价" Binding="{Binding PurchasePrice, StringFormat=N2}" Width="90" />
                            <DataGridTextColumn Header="售价" Binding="{Binding Price, StringFormat=N2}" Width="90" />
                            <DataGridTextColumn Header="库位" Binding="{Binding Position}" Width="*" />
                            <DataGridTemplateColumn Header="操作" Width="126" CellTemplate="{StaticResource RecordEditDeleteTemplate}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{DynamicResource ContentCardStyle}" Padding="22" Width="360" Margin="16,0,0,0"
                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibility}}" dialog:EditorDialog.IsOpen="{Binding IsEditing}" dialog:EditorDialog.Title="{Binding EditorTitle}" dialog:EditorDialog.CancelCommand="{Binding CancelCommand}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{DynamicResource PageTitleTextStyle}" />
                        <TextBlock Text="产品类型 *" Margin="0,20,0,7" />
                        <ComboBox ItemsSource="{Binding ProductTypes}" DisplayMemberPath="FunctionName" SelectedItem="{Binding SelectedType}"
                                  IsEnabled="{Binding CanChangeType}" />
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,14,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Text=" *" Foreground="#C53B3B"
                                                       Visibility="{Binding IsRequired, Converter={StaticResource BooleanToVisibility}}" />
                                        </StackPanel>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="采购价" Margin="0,16,0,7" /><TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="销售价" Margin="0,16,0,7" /><TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="红包最低价" Margin="0,16,0,7" /><TextBox Text="{Binding RedPacketPriceLow, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="红包最高价" Margin="0,16,0,7" /><TextBox Text="{Binding RedPacketPriceHigh, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="库位" Margin="0,16,0,7" /><TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="体积" Margin="0,16,0,7" /><TextBox Text="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Content="保存" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                            <Button Content="取消" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
