<UserControl xmlns:dialog="clr-namespace:Psdr.UI.Behaviors;assembly=Psdr.UI" x:Class="Psdr.Desktop.Views.BaseData.SalesMan.SalesManView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="销售人员维护" Style="{DynamicResource PageTitleTextStyle}" />
                    <TextBlock Text="管理当前代理的销售人员资料" Margin="0,5,0,0"
                               Style="{DynamicResource SecondaryTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="＋ 新增销售人员" Command="{Binding NewCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource ContentCardStyle}" Padding="20"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="12" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="销售人员" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="14" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="220" ToolTip="按姓名筛选" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" MaxHeight="520"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编号" Binding="{Binding SalesID}" Width="100" />
                            <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="2*" />
                            <DataGridTemplateColumn Header="状态" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource RecordStatusBadgeStyle}">
                                            <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RecordStatusTextStyle}">
                                                    <Setter Property="Text" Value="停用" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="1">
                                                            <Setter Property="Text" Value="启用" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="126"
                                                    CellTemplate="{StaticResource RecordEditDeleteTemplate}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource ContentCardStyle}" Padding="22"
                    Width="360" Margin="16,0,0,0"
                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibility}}" dialog:EditorDialog.IsOpen="{Binding IsEditing}" dialog:EditorDialog.Title="{Binding EditorTitle}" dialog:EditorDialog.CancelCommand="{Binding CancelCommand}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="保存" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                        <Button Content="取消" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{DynamicResource PageTitleTextStyle}" />
                        <TextBlock Text="姓名 *" Margin="0,17,0,5" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="启用" IsChecked="{Binding IsActive}" Margin="0,17,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
