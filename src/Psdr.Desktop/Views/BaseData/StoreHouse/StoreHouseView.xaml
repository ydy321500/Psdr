<UserControl x:Class="Psdr.Desktop.Views.BaseData.StoreHouse.StoreHouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="仓库维护" Style="{DynamicResource PageTitleTextStyle}" />
                    <TextBlock Text="统一管理代理库中的仓库资料" Margin="0,5,0,0"
                               Style="{DynamicResource SecondaryTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="＋ 新增仓库" Command="{Binding NewCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{DynamicResource ContentCardStyle}" Padding="20"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="仓库名称" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="14" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="200" ToolTip="输入仓库名称筛选" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="刷新" Margin="8,0,0,0"
                                Command="{Binding RefreshCommand}" />
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" MaxHeight="520"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编号" Binding="{Binding StoreHouseID}" Width="80" />
                            <DataGridTextColumn Header="仓库名称" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="3*" />
                            <DataGridTemplateColumn Header="操作" Width="126"
                                                    CellTemplate="{StaticResource RecordEditDeleteTemplate}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource ContentCardStyle}" Padding="22"
                    Width="320" Margin="16,0,0,0"
                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{DynamicResource PageTitleTextStyle}" />
                    <TextBlock Text="仓库名称 *" Margin="0,24,0,8" />
                    <TextBox Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="备注" Margin="0,20,0,8" />
                    <TextBox Text="{Binding EditorRemark, UpdateSourceTrigger=PropertyChanged}"
                             Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" />
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button Content="保存" Command="{Binding SaveCommand}"
                                Style="{DynamicResource PrimaryButtonStyle}" />
                        <Button Content="取消" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
