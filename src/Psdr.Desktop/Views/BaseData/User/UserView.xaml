<UserControl xmlns:dialog="clr-namespace:Psdr.UI.Behaviors;assembly=Psdr.UI" x:Class="Psdr.Desktop.Views.BaseData.User.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="用户维护" Style="{DynamicResource PageTitleTextStyle}" />
                    <TextBlock Text="管理当前代理的业务账号和页面权限" Margin="0,5,0,0"
                               Style="{DynamicResource SecondaryTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="＋ 新增用户" Command="{Binding NewCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource ContentCardStyle}" Padding="20"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="12" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="账号 / 姓名" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="14" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="220" ToolTip="按账号或姓名筛选" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" MaxHeight="520"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="账号" Binding="{Binding UserCode}" Width="*" />
                            <DataGridTextColumn Header="姓名" Binding="{Binding UserName}" Width="*" />
                            <DataGridTemplateColumn Header="状态" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource RecordStatusBadgeStyle}">
                                            <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RecordStatusTextStyle}">
                                                    <Setter Property="Text" Value="停用" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="1">
                                                            <Setter Property="Text" Value="启用" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="126"
                                                    CellTemplate="{StaticResource RecordEditDeleteTemplate}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource ContentCardStyle}" Padding="22"
                    Width="390" Margin="16,0,0,0"
                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibility}}" dialog:EditorDialog.IsOpen="{Binding IsEditing}" dialog:EditorDialog.Title="{Binding EditorTitle}" dialog:EditorDialog.CancelCommand="{Binding CancelCommand}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="保存" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                        <Button Content="取消" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding EditorTitle}" Style="{DynamicResource PageTitleTextStyle}" />
                            <TextBlock Text="新增账号初始密码为 123456；admin 账号不能删除或停用。"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Style="{DynamicResource SecondaryTextStyle}" />
                            <TextBlock Text="账号 *" Margin="0,17,0,5" />
                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="姓名 *" Margin="0,12,0,5" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="启用" IsChecked="{Binding IsActive}" Margin="0,15,0,0" />
                            <TextBlock Text="可访问页面 *" Margin="0,17,0,8" />
                            <ItemsControl ItemsSource="{Binding Roles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,4,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
