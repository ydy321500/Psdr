<Window x:Class="Psdr.Desktop.Views.Common.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="确认操作" Width="420" Height="220" MinWidth="420" MinHeight="220"
        MaxWidth="420" MaxHeight="220" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" Background="White" ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="65" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="3" Panel.ZIndex="10" Style="{DynamicResource DialogOutlineStyle}" />
        <Border Grid.Row="0" Style="{DynamicResource DialogHeaderStyle}">
            <Grid>
                <TextBlock Text="确认操作" Foreground="White" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="20,0,0,0" />
                <Button Style="{DynamicResource LoginWindowButtonStyle}" Content="×" FontSize="21"
                        HorizontalAlignment="Right" Margin="0,4,8,4" Click="CancelClick"
                        ToolTip="关闭" AutomationProperties.AutomationId="ConfirmClose"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="24,22,24,0"
                   TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource TextBrush}" />
        <Grid Grid.Row="2" Margin="24,0,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="确定" Style="{DynamicResource LoginPrimaryButtonStyle}"
                    Height="39" Click="ConfirmClick" IsDefault="True"
                    AutomationProperties.AutomationId="ConfirmAccept" />
            <Button Grid.Column="3" Content="取消" Style="{DynamicResource LoginSecondaryButtonStyle}"
                    Height="39" Click="CancelClick" IsCancel="True"
                    AutomationProperties.AutomationId="ConfirmCancel" />
        </Grid>
    </Grid>
</Window>
