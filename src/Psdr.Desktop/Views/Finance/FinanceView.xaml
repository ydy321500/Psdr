<UserControl x:Class="Psdr.Desktop.Views.Finance.FinanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="财务往来" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="记录客户与供应商的应收应付、收款和付款流水" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel><Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/></Grid></Border>
        <Border Grid.Row="2" Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox SelectedValue="{Binding PartnerType}" SelectedValuePath="Content"><ComboBoxItem Content="客户"/><ComboBoxItem Content="供应商"/></ComboBox><Grid Grid.Column="2"><ComboBox ItemsSource="{Binding Shops}" DisplayMemberPath="ShopName" SelectedItem="{Binding SelectedShop}"><ComboBox.Style><Style TargetType="ComboBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding PartnerType}" Value="供应商"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox><ComboBox ItemsSource="{Binding Supplies}" DisplayMemberPath="SupplyName" SelectedItem="{Binding SelectedSupply}"><ComboBox.Style><Style TargetType="ComboBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PartnerType}" Value="供应商"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox></Grid><TextBox Grid.Column="4" Text="{Binding Money, UpdateSourceTrigger=PropertyChanged}" ToolTip="金额"/><ComboBox Grid.Column="6" SelectedValue="{Binding TransactionType}" SelectedValuePath="Tag"><ComboBoxItem Content="记账" Tag="0"/><ComboBoxItem Content="销账" Tag="1"/></ComboBox><TextBox Grid.Column="8" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" ToolTip="关联单号（可选）"/><Button Grid.Column="10" Content="保存账务" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}"/></Grid></Border>
        <Border Grid.Row="4" Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="财务流水" Style="{DynamicResource SectionTitleTextStyle}"/><Button Grid.Column="1" Content="删除所选" Command="{Binding DeleteCommand}"/></Grid><DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"><DataGrid.Columns><DataGridTextColumn Header="对象" Binding="{Binding PartnerType}" Width="80"/><DataGridTextColumn Header="单位" Binding="{Binding PartnerName}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="70"/><DataGridTextColumn Header="金额" Binding="{Binding Money, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="单号" Binding="{Binding No}" Width="2*"/><DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/><DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}"/></Grid></Border>
    </Grid>
</UserControl>
