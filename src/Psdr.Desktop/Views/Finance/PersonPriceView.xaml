<UserControl x:Class="Psdr.Desktop.Views.Finance.PersonPriceView" xmlns:dialog="clr-namespace:Psdr.UI.Behaviors;assembly=Psdr.UI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{DynamicResource ContentCardStyle}" Padding="22,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="专属价格" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="维护客户专属售价或供应商专属进价；选择对象和产品后自动回显已有设置。" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="刷新资料" Command="{Binding RefreshCommand}"/><Button Content="编辑价格" Margin="8,0,0,0" Style="{DynamicResource PrimaryButtonStyle}" dialog:EditorDialog.Target="{Binding ElementName=EditorPanel}"/></StackPanel></Grid></Border><Border x:Name="EditorPanel" Grid.Row="2" Style="{DynamicResource ContentCardStyle}" Padding="22" Visibility="Collapsed" dialog:EditorDialog.Title="专属价格" dialog:EditorDialog.Status="{Binding StatusMessage}" dialog:EditorDialog.SuccessText="专属价格已保存。"><StackPanel><TextBlock Text="价格类型"/><ComboBox SelectedValue="{Binding PriceType}" SelectedValuePath="Content" Margin="0,7,0,0"><ComboBoxItem Content="客户"/><ComboBoxItem Content="供应商"/></ComboBox><StackPanel Margin="0,16,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding PriceType}" Value="供应商"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="客户" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding Shops}" DisplayMemberPath="ShopName" SelectedItem="{Binding SelectedShop}"/></StackPanel><StackPanel Margin="0,16,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PriceType}" Value="供应商"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="供应商" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding Supplies}" DisplayMemberPath="SupplyName" SelectedItem="{Binding SelectedSupply}"/></StackPanel><TextBlock Text="产品" Margin="0,16,0,7"/><ComboBox ItemsSource="{Binding Products}" DisplayMemberPath="ProductName" SelectedItem="{Binding SelectedProduct}"/><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" ToolTip="客户专属售价或供应商专属进价"/><TextBox Grid.Column="2" Text="{Binding RedLow, UpdateSourceTrigger=PropertyChanged}" ToolTip="红包最低价（仅客户）"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding PriceType}" Value="供应商"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><TextBox Grid.Column="4" Text="{Binding RedHigh, UpdateSourceTrigger=PropertyChanged}" ToolTip="红包最高价（仅客户）"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding PriceType}" Value="供应商"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></Grid><Button Content="保存专属价格" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,22,0,0" HorizontalAlignment="Left"/><TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,16,0,0"/></StackPanel></Border></Grid></UserControl>
