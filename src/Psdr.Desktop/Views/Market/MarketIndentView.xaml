<UserControl x:Class="Psdr.Desktop.Views.Market.MarketIndentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{DynamicResource ContentCardStyle}" Padding="22,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="市场订单" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="审核市场端提交的订单状态；确认后仍需在销售出库中完成发货。" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="确认订单" Command="{Binding ConfirmCommand}" Style="{DynamicResource PrimaryButtonStyle}"/><Button Content="关闭订单" Command="{Binding CloseCommand}" Margin="8,0,0,0"/><Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/></StackPanel></Grid></Border><Border Grid.Row="2" Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="订单号" Binding="{Binding IndentNo}" Width="2*"/><DataGridTextColumn Header="产品" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="数量" Binding="{Binding Amount}" Width="100"/><DataGridTextColumn Header="状态" Binding="{Binding StateName}" Width="110"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}"/></Grid></Border></Grid></UserControl>
