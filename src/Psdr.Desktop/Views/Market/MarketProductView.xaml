<UserControl x:Class="Psdr.Desktop.Views.Market.MarketProductView" xmlns:dialog="clr-namespace:Psdr.UI.Behaviors;assembly=Psdr.UI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{DynamicResource ContentCardStyle}" Padding="22,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="市场产品" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="配置市场端展示的产品和价格" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="刷新" Command="{Binding RefreshCommand}"/><Button Content="新增" Command="{Binding NewCommand}" dialog:EditorDialog.Target="{Binding ElementName=EditorPanel}" Style="{DynamicResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions><Border Style="{DynamicResource ContentCardStyle}" Padding="20"><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" dialog:EditorDialog.Target="{Binding ElementName=EditorPanel}" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="产品" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding ProductType}" Width="80"/><DataGridTextColumn Header="价格" Binding="{Binding Price, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="关键词" Binding="{Binding KeyWord}" Width="*"/></DataGrid.Columns></DataGrid></Border><Border x:Name="EditorPanel" Grid.Column="2" Style="{DynamicResource ContentCardStyle}" Padding="20" Visibility="Collapsed" dialog:EditorDialog.Title="市场产品" dialog:EditorDialog.Status="{Binding Status}" dialog:EditorDialog.CancelCommand="{Binding CancelCommand}" dialog:EditorDialog.SuccessText="市场产品已保存。"><StackPanel><TextBlock Text="编辑市场产品" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="本地产品" Margin="0,18,0,7"/><ComboBox ItemsSource="{Binding Products}" DisplayMemberPath="ProductName" SelectedItem="{Binding Product}"/><TextBlock Text="类型：0 普通，1 主推" Margin="0,14,0,7"/><TextBox Text="{Binding Selected.ProductType, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="市场价格" Margin="0,14,0,7"/><TextBox Text="{Binding Selected.Price, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="关键词" Margin="0,14,0,7"/><TextBox Text="{Binding Selected.KeyWord, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="图片地址" Margin="0,14,0,7"/><TextBox Text="{Binding Selected.ImageUrl, UpdateSourceTrigger=PropertyChanged}"/><StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="保存" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}"/><Button Content="删除" Command="{Binding DeleteCommand}" Margin="8,0,0,0"/></StackPanel><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border></Grid></Grid></UserControl>
