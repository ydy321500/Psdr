<UserControl x:Class="Psdr.Desktop.Views.Market.MarketUserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="市场会员" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="维护市场端登录账号及收货资料" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="新增" Command="{Binding NewCommand}"/><Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/></StackPanel></Grid>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="账号" Binding="{Binding UserCode}" Width="*"/><DataGridTextColumn Header="会员名称" Binding="{Binding UserName}" Width="*"/><DataGridTextColumn Header="电话" Binding="{Binding Tel}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80"/></DataGrid.Columns></DataGrid>
            <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}"/>
        </Grid></Border>
        <Border Grid.Column="2" Style="{DynamicResource ContentCardStyle}" Padding="20"><StackPanel><TextBlock Text="会员资料" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="市场账号 *" Margin="0,20,0,6"/><TextBox Text="{Binding UserCode, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="会员名称 *" Margin="0,14,0,6"/><TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="登录密码 *" Margin="0,14,0,6"/><TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="联系电话" Margin="0,14,0,6"/><TextBox Text="{Binding Tel, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="收货地址" Margin="0,14,0,6"/><TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap"/><CheckBox Content="启用市场会员" IsChecked="{Binding Enabled}" Margin="0,16,0,0"/><Button Content="保存市场会员" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border>
    </Grid>
</UserControl>
