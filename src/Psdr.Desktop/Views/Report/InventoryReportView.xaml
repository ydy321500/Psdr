<UserControl x:Class="Psdr.Desktop.Views.Report.InventoryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="库存汇总报表" Style="{DynamicResource PageTitleTextStyle}" />
                    <TextBlock Text="按仓库和产品汇总当前实际库存，不产生库存变更。"
                               Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{DynamicResource ContentCardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="仓库" Binding="{Binding StoreHouseName}" Width="*" />
                        <DataGridTextColumn Header="产品" Binding="{Binding ProductName}" Width="2*" />
                        <DataGridTextColumn Header="库存数量" Binding="{Binding Amount}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
