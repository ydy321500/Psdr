<UserControl x:Class="Psdr.Desktop.Views.Report.ReportStyleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions><Border Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="报表模板" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="管理代理库内的 FastReport 模板文件" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="新增" Command="{Binding NewCommand}"/><Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/></StackPanel></Grid><DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="模板名称" Binding="{Binding ReportName}" Width="*"/><DataGridTextColumn Header="编号" Binding="{Binding ReportID}" Width="90"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/></Grid></Border><Border Grid.Column="2" Style="{DynamicResource ContentCardStyle}" Padding="20"><StackPanel><TextBlock Text="模板资料" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="名称 *" Margin="0,20,0,6"/><TextBox Text="{Binding ReportName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="模板文件 *" Margin="0,14,0,6"/><TextBlock Text="{Binding SourceFileName}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/><Button Content="导入 .frx 文件" Command="{Binding ImportCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="保存模板" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}"/><Button Content="导出" Command="{Binding ExportCommand}" Margin="8,0,0,0"/><Button Content="删除" Command="{Binding DeleteCommand}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></Grid></UserControl>
