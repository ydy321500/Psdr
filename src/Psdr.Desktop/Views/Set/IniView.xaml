<UserControl x:Class="Psdr.Desktop.Views.Set.IniView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{DynamicResource ContentCardStyle}" Padding="22,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="系统设置" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="维护代理库的系统配置项" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="刷新" Command="{Binding RefreshCommand}"/><Button Content="新增配置" Command="{Binding NewCommand}" Style="{DynamicResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions><Border Style="{DynamicResource ContentCardStyle}" Padding="20"><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80"/><DataGridTextColumn Header="名称" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="值" Binding="{Binding Value}" Width="2*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80"/></DataGrid.Columns></DataGrid></Border><Border Grid.Column="2" Style="{DynamicResource ContentCardStyle}" Padding="20"><StackPanel><TextBlock Text="编辑配置" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="类型" Margin="0,18,0,7"/><TextBox Text="{Binding Selected.Type, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="名称" Margin="0,14,0,7"/><TextBox Text="{Binding Selected.Title, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="值" Margin="0,14,0,7"/><TextBox Text="{Binding Selected.Value, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="状态" Margin="0,14,0,7"/><TextBox Text="{Binding Selected.State, UpdateSourceTrigger=PropertyChanged}"/><Button Content="保存" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,22,0,0" HorizontalAlignment="Left"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,16,0,0"/></StackPanel></Border></Grid></Grid></UserControl>
