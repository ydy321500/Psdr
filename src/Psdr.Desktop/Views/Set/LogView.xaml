<UserControl x:Class="Psdr.Desktop.Views.Set.LogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{DynamicResource ContentCardStyle}" Padding="22,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="操作日志" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="查看当前代理库最近操作记录" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel><Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}"/></Grid></Border><Border Grid.Row="2" Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding LogTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/><DataGridTextColumn Header="用户" Binding="{Binding UserName}" Width="*"/><DataGridTextColumn Header="机器" Binding="{Binding MachineInfo}" Width="*"/><DataGridTextColumn Header="事件" Binding="{Binding Event}" Width="2*"/><DataGridTextColumn Header="信息" Binding="{Binding Info}" Width="2*"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}"/></Grid></Border></Grid></UserControl>
