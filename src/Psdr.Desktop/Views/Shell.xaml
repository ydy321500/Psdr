<Window x:Class="Psdr.Desktop.Views.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:vm="clr-namespace:Psdr.Desktop.ViewModels"
        xmlns:storeVm="clr-namespace:Psdr.Desktop.ViewModels.BaseData.StoreHouse"
        xmlns:supplyVm="clr-namespace:Psdr.Desktop.ViewModels.BaseData.Supply"
        xmlns:shopVm="clr-namespace:Psdr.Desktop.ViewModels.BaseData.Shop"
        xmlns:salesManVm="clr-namespace:Psdr.Desktop.ViewModels.BaseData.SalesMan"
        xmlns:userVm="clr-namespace:Psdr.Desktop.ViewModels.BaseData.User"
        xmlns:productMapVm="clr-namespace:Psdr.Desktop.ViewModels.Set.ProductMap"
        xmlns:dictionaryVm="clr-namespace:Psdr.Desktop.ViewModels.BaseData.Dictionary"
        xmlns:views="clr-namespace:Psdr.Desktop.Views"
        xmlns:storeViews="clr-namespace:Psdr.Desktop.Views.BaseData.StoreHouse"
        xmlns:supplyViews="clr-namespace:Psdr.Desktop.Views.BaseData.Supply"
        xmlns:shopViews="clr-namespace:Psdr.Desktop.Views.BaseData.Shop"
        xmlns:salesManViews="clr-namespace:Psdr.Desktop.Views.BaseData.SalesMan"
        xmlns:userViews="clr-namespace:Psdr.Desktop.Views.BaseData.User"
        xmlns:productMapViews="clr-namespace:Psdr.Desktop.Views.Set.ProductMap"
        xmlns:dictionaryViews="clr-namespace:Psdr.Desktop.Views.BaseData.Dictionary"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="进销存红包系统" Width="1280" Height="760"
        MinWidth="1050" MinHeight="600" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" WindowState="Maximized"
        Closing="OnClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type storeVm:StoreHouseViewModel}">
            <storeViews:StoreHouseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type supplyVm:SupplyViewModel}">
            <supplyViews:SupplyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type shopVm:ShopViewModel}">
            <shopViews:ShopView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type salesManVm:SalesManViewModel}">
            <salesManViews:SalesManView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type userVm:UserViewModel}">
            <userViews:UserView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type productMapVm:ProductMapViewModel}">
            <productMapViews:ProductMapView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type dictionaryVm:DictionaryViewModel}">
            <dictionaryViews:DictionaryView />
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{DynamicResource TitleBarButtonStyle}"
                        Command="{Binding ToggleSidebarVisibilityCommand}" ToolTip="显示或隐藏侧栏"
                        AutomationProperties.Name="显示或隐藏侧栏" AutomationProperties.AutomationId="ToggleSidebarVisibility"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource MenuIconGeometry}" Stroke="{DynamicResource TextBrush}"
                          StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                </Button>
                <TextBlock Grid.Column="1" Text="进销存红包系统" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="16" Margin="12,0,0,0" />
                <Grid Grid.Column="2" Margin="24,0,0,0" HorizontalAlignment="Left"
                      Visibility="{Binding IsSidebarVisible, Converter={StaticResource BooleanToVisibility}}">
                    <Button Style="{DynamicResource NavigationTitleBarButtonStyle}"
                            Command="{Binding ToggleSidebarExpandedCommand}" ToolTip="收起导航栏"
                            AutomationProperties.Name="收起导航栏" AutomationProperties.AutomationId="CollapseSidebar"
                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibility}}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CollapseIconGeometry}" Stroke="{DynamicResource TextBrush}"
                                  StrokeThickness="1.7" Width="17" Height="17" Stretch="Uniform" />
                            <TextBlock Text="收起导航" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource NavigationTitleBarButtonStyle}"
                            Command="{Binding ToggleSidebarExpandedCommand}" ToolTip="展开导航栏"
                            AutomationProperties.Name="展开导航栏" AutomationProperties.AutomationId="ExpandSidebar"
                            Visibility="{Binding IsSidebarCompact, Converter={StaticResource BooleanToVisibility}}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ExpandIconGeometry}" Stroke="{DynamicResource TextBrush}"
                                  StrokeThickness="1.7" Width="17" Height="17" Stretch="Uniform" />
                            <TextBlock Text="展开导航" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Button Grid.Column="3" Style="{DynamicResource TitleBarButtonStyle}"
                        Command="{Binding MinimizeCommand}" ToolTip="最小化"
                        AutomationProperties.Name="最小化" AutomationProperties.AutomationId="MinimizeWindow"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource MinimizeIconGeometry}" Stroke="{DynamicResource TextBrush}"
                          StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" />
                </Button>
                <Button Grid.Column="4" Style="{DynamicResource TitleBarButtonStyle}"
                        Command="{Binding ToggleMaximizeCommand}" ToolTip="最大化或还原"
                        AutomationProperties.Name="最大化或还原" AutomationProperties.AutomationId="ToggleMaximizeWindow"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7"
                          Width="15" Height="15" Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource MaximizeIconGeometry}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="Data" Value="{StaticResource RestoreIconGeometry}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button Grid.Column="5" Style="{DynamicResource CloseTitleBarButtonStyle}"
                        Command="{Binding CloseCommand}" ToolTip="关闭"
                        AutomationProperties.Name="关闭" AutomationProperties.AutomationId="CloseWindow"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource CloseIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" ClipToBounds="True"
                    Visibility="{Binding IsSidebarVisible, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibility}}">
                            <Border Width="40" Height="40" CornerRadius="9"
                                    Background="{DynamicResource SidebarHoverBrush}">
                                <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="21"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PSDR" Foreground="White" FontWeight="SemiBold" FontSize="18" />
                                <TextBlock Text="业务管理平台" Style="{DynamicResource SidebarCaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="9" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Background="{DynamicResource SidebarHoverBrush}"
                                Visibility="{Binding IsSidebarCompact, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="21"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <StackPanel Margin="12,12,12,0"
                                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibility}}">
                                <ToggleButton Style="{DynamicResource SidebarNavigationStyle}"
                                              IsChecked="{Binding IsHomeActive, Mode=OneWay}"
                                              Command="{Binding NavigateHomeCommand}" Padding="14,0"
                                              AutomationProperties.Name="系统看板" AutomationProperties.AutomationId="NavigateHomeExpanded">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource DashboardIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              StrokeThickness="1.7" Width="21" Height="21" Stretch="Uniform" />
                                        <TextBlock Text="系统看板" Margin="14,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button Style="{DynamicResource SidebarSectionButtonStyle}"
                                        Command="{Binding ToggleBaseDataGroupCommand}"
                                        Margin="0,12,0,4" Padding="14,0" HorizontalContentAlignment="Stretch"
                                        Visibility="{Binding HasBaseDataAccess, Converter={StaticResource BooleanToVisibility}}"
                                        AutomationProperties.Name="开合基础数据" AutomationProperties.AutomationId="ToggleBaseDataGroup">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="22" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource BaseDataIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7" Width="21" Height="21" Stretch="Uniform"
                                              VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="基础数据" Margin="14,0,0,0" VerticalAlignment="Center" />
                                        <Path Grid.Column="2" Data="{StaticResource ChevronIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.9" Width="15" Height="15" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value><RotateTransform Angle="-90" /></Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBaseDataGroupExpanded}" Value="True">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </Button>
                                <StackPanel Visibility="{Binding IsBaseDataGroupExpanded, Converter={StaticResource BooleanToVisibility}}">
                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                              IsChecked="{Binding IsStoreHouseActive, Mode=OneWay}"
                                              Command="{Binding NavigateStoreHouseCommand}" Padding="49,0"
                                              AutomationProperties.Name="仓库维护" AutomationProperties.AutomationId="NavigateStoreHouseExpanded"
                                              Visibility="{Binding CanStoreHouse, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource WarehouseIconGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                        <TextBlock Text="仓库维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                              IsChecked="{Binding IsSupplyActive, Mode=OneWay}"
                                              Command="{Binding NavigateSupplyCommand}" Padding="49,0"
                                              AutomationProperties.Name="供应商维护" AutomationProperties.AutomationId="NavigateSupplyExpanded"
                                              Visibility="{Binding CanSupply, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource SupplierIconGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                        <TextBlock Text="供应商维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                              IsChecked="{Binding IsShopActive, Mode=OneWay}"
                                              Command="{Binding NavigateShopCommand}" Padding="49,0"
                                              AutomationProperties.Name="客户维护" AutomationProperties.AutomationId="NavigateShopExpanded"
                                              Visibility="{Binding CanShop, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource CustomerIconGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                        <TextBlock Text="客户维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                              IsChecked="{Binding IsSalesManActive, Mode=OneWay}"
                                              Command="{Binding NavigateSalesManCommand}" Padding="49,0"
                                              AutomationProperties.Name="销售人员维护" AutomationProperties.AutomationId="NavigateSalesManExpanded"
                                              Visibility="{Binding CanSalesMan, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource SalesManIconGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                        <TextBlock Text="销售人员维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                              IsChecked="{Binding IsDictionaryActive, Mode=OneWay}"
                                              Command="{Binding NavigateDictionaryCommand}" Padding="49,0"
                                              Visibility="{Binding CanDictionary, Converter={StaticResource BooleanToVisibility}}"
                                              AutomationProperties.Name="字典维护">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource DictionaryIconGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                        <TextBlock Text="字典维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                              IsChecked="{Binding IsUserActive, Mode=OneWay}"
                                              Command="{Binding NavigateUserCommand}" Padding="49,0"
                                              Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibility}}"
                                              AutomationProperties.Name="用户维护" AutomationProperties.AutomationId="NavigateUserExpanded">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource UserManagementIconGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                        <TextBlock Text="用户维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                </StackPanel>
                                <Button Style="{DynamicResource SidebarSectionButtonStyle}"
                                        Command="{Binding ToggleSettingsGroupCommand}"
                                        Margin="0,12,0,4" Padding="14,0" HorizontalContentAlignment="Stretch"
                                        Visibility="{Binding CanProductMap, Converter={StaticResource BooleanToVisibility}}"
                                        AutomationProperties.Name="开合系统设置">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="22" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource SettingsIconGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7" Width="21" Height="21" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1" Text="系统设置" Margin="14,0,0,0" VerticalAlignment="Center" />
                                        <Path Grid.Column="2" Data="{StaticResource ChevronIconGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.9" Width="15" Height="15" Stretch="Uniform" />
                                    </Grid>
                                </Button>
                                <StackPanel Visibility="{Binding IsSettingsGroupExpanded, Converter={StaticResource BooleanToVisibility}}">
                                    <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                                  IsChecked="{Binding IsProductMapActive, Mode=OneWay}"
                                                  Command="{Binding NavigateProductMapCommand}" Padding="49,0"
                                                  Visibility="{Binding CanProductMap, Converter={StaticResource BooleanToVisibility}}"
                                                  AutomationProperties.Name="产品属性">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource ProductMapIconGeometry}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                  StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                            <TextBlock Text="产品属性" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="10,12,10,0"
                                        Visibility="{Binding IsSidebarCompact, Converter={StaticResource BooleanToVisibility}}">
                                <ToggleButton Style="{DynamicResource SidebarNavigationStyle}"
                                              IsChecked="{Binding IsHomeActive, Mode=OneWay}"
                                              Command="{Binding NavigateHomeCommand}" ToolTip="系统看板"
                                              AutomationProperties.Name="系统看板" AutomationProperties.AutomationId="NavigateHomeCompact"
                                              HorizontalContentAlignment="Center">
                                    <Path Data="{StaticResource DashboardIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.7" Width="19" Height="19" Stretch="Uniform" />
                                </ToggleButton>
                                <Grid Margin="0,12,0,0"
                                      Visibility="{Binding HasBaseDataAccess, Converter={StaticResource BooleanToVisibility}}">
                                    <ToggleButton x:Name="CompactBaseDataButton"
                                                  Style="{DynamicResource SidebarNavigationStyle}"
                                                  IsChecked="{Binding IsCompactBaseDataMenuOpen, Mode=TwoWay}"
                                                  ToolTip="基础数据" HorizontalContentAlignment="Center"
                                                  AutomationProperties.Name="基础数据" AutomationProperties.AutomationId="OpenCompactBaseDataMenu">
                                        <Path Data="{StaticResource BaseDataIconGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              StrokeThickness="1.7" Width="19" Height="19" Stretch="Uniform" />
                                    </ToggleButton>
                                    <Popup PlacementTarget="{Binding ElementName=CompactBaseDataButton}"
                                           Placement="Right" HorizontalOffset="8" StaysOpen="False"
                                           AllowsTransparency="True"
                                           IsOpen="{Binding IsCompactBaseDataMenuOpen, Mode=TwoWay}">
                                        <Border Width="202" Padding="8" CornerRadius="8"
                                                Background="{DynamicResource SidebarBrush}"
                                                BorderBrush="{DynamicResource SidebarHoverBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="基础数据" Margin="12,7,0,8"
                                                           Foreground="{DynamicResource SidebarSectionBrush}"
                                                           FontSize="13" />
                                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                                              IsChecked="{Binding IsStoreHouseActive, Mode=OneWay}"
                                                              Command="{Binding NavigateStoreHouseCommand}" Padding="12,0"
                                                              Visibility="{Binding CanStoreHouse, Converter={StaticResource BooleanToVisibility}}"
                                                              AutomationProperties.Name="仓库维护" AutomationProperties.AutomationId="NavigateStoreHouseCompact">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource WarehouseIconGeometry}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                              StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                                        <TextBlock Text="仓库维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                                              IsChecked="{Binding IsSupplyActive, Mode=OneWay}"
                                                              Command="{Binding NavigateSupplyCommand}" Padding="12,0"
                                                              Visibility="{Binding CanSupply, Converter={StaticResource BooleanToVisibility}}"
                                                              AutomationProperties.Name="供应商维护" AutomationProperties.AutomationId="NavigateSupplyCompact">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource SupplierIconGeometry}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                              StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                                        <TextBlock Text="供应商维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                                              IsChecked="{Binding IsShopActive, Mode=OneWay}"
                                                              Command="{Binding NavigateShopCommand}" Padding="12,0"
                                                              Visibility="{Binding CanShop, Converter={StaticResource BooleanToVisibility}}"
                                                              AutomationProperties.Name="客户维护" AutomationProperties.AutomationId="NavigateShopCompact">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource CustomerIconGeometry}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                              StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                                        <TextBlock Text="客户维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                                              IsChecked="{Binding IsSalesManActive, Mode=OneWay}"
                                                              Command="{Binding NavigateSalesManCommand}" Padding="12,0"
                                                              Visibility="{Binding CanSalesMan, Converter={StaticResource BooleanToVisibility}}"
                                                              AutomationProperties.Name="销售人员维护" AutomationProperties.AutomationId="NavigateSalesManCompact">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource SalesManIconGeometry}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                              StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                                        <TextBlock Text="销售人员维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                                              IsChecked="{Binding IsDictionaryActive, Mode=OneWay}"
                                                              Command="{Binding NavigateDictionaryCommand}" Padding="12,0"
                                                              Visibility="{Binding CanDictionary, Converter={StaticResource BooleanToVisibility}}"
                                                              AutomationProperties.Name="字典维护">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource DictionaryIconGeometry}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                              StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                                        <TextBlock Text="字典维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                                              IsChecked="{Binding IsUserActive, Mode=OneWay}"
                                                              Command="{Binding NavigateUserCommand}" Padding="12,0"
                                                              Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibility}}"
                                                              AutomationProperties.Name="用户维护" AutomationProperties.AutomationId="NavigateUserCompact">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource UserManagementIconGeometry}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                              StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                                        <TextBlock Text="用户维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid Visibility="{Binding CanProductMap, Converter={StaticResource BooleanToVisibility}}">
                                    <ToggleButton x:Name="CompactSettingsButton"
                                                  Style="{DynamicResource SidebarNavigationStyle}"
                                                  IsChecked="{Binding IsCompactSettingsMenuOpen, Mode=TwoWay}"
                                                  ToolTip="系统设置" HorizontalContentAlignment="Center"
                                                  AutomationProperties.Name="系统设置" AutomationProperties.AutomationId="OpenCompactSettingsMenu">
                                        <Path Data="{StaticResource SettingsIconGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              StrokeThickness="1.7" Width="19" Height="19" Stretch="Uniform" />
                                    </ToggleButton>
                                    <Popup PlacementTarget="{Binding ElementName=CompactSettingsButton}"
                                           Placement="Right" HorizontalOffset="8" StaysOpen="False"
                                           AllowsTransparency="True"
                                           IsOpen="{Binding IsCompactSettingsMenuOpen, Mode=TwoWay}">
                                        <Border Width="202" Padding="8" CornerRadius="8"
                                                Background="{DynamicResource SidebarBrush}"
                                                BorderBrush="{DynamicResource SidebarHoverBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="系统设置" Margin="12,7,0,8"
                                                           Foreground="{DynamicResource SidebarSectionBrush}"
                                                           FontSize="13" />
                                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}"
                                                              IsChecked="{Binding IsProductMapActive, Mode=OneWay}"
                                                              Command="{Binding NavigateProductMapCommand}" Padding="12,0"
                                                              AutomationProperties.Name="产品属性" AutomationProperties.AutomationId="NavigateProductMapCompact">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource ProductMapIconGeometry}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                              StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                                        <TextBlock Text="产品属性" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="26,0">
                        <TextBlock Text="{Binding PageTitle}" VerticalAlignment="Center"
                                   Style="{DynamicResource PageTitleTextStyle}" />
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ToggleButton x:Name="UserMenuButton" Style="{DynamicResource UserMenuToggleStyle}"
                                          IsChecked="{Binding IsUserMenuOpen, Mode=TwoWay}"
                                          AutomationProperties.Name="用户信息" AutomationProperties.AutomationId="UserMenu"
                                          ToolTip="查看业务用户信息">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentUserName}" VerticalAlignment="Center"
                                               Margin="0,0,10,0" FontWeight="SemiBold" />
                                    <Border Width="34" Height="34" Background="{DynamicResource CanvasBrush}"
                                            CornerRadius="17" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding CurrentUserInitial}" Foreground="{DynamicResource PrimaryBrush}"
                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>
                            <Popup PlacementTarget="{Binding ElementName=UserMenuButton}"
                                   Placement="Bottom" HorizontalOffset="-8" VerticalOffset="8"
                                   IsOpen="{Binding IsUserMenuOpen, Mode=TwoWay}"
                                   StaysOpen="False" AllowsTransparency="True">
                                <Border Width="262" Padding="18" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Text="用户信息" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="业务用户" Margin="0,16,0,3"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding CurrentUserName}" />
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                                Margin="0,14,0,12" />
                                        <TextBlock Text="账号" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding CurrentUserCode}" Margin="0,3,0,0" />
                                        <TextBlock Text="角色" Margin="0,12,0,3" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding CurrentUserRole}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>
                <TabControl Grid.Row="1" ItemsSource="{Binding Tabs}"
                            SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                            AutomationProperties.AutomationId="WorkspaceTabs"
                            Style="{StaticResource WorkspaceTabControlStyle}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource WorkspaceTabItemStyle}" />
                    </TabControl.ItemContainerStyle>
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                <Button Content="×" Style="{StaticResource WorkspaceTabCloseButtonStyle}"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{Binding}" ToolTip="关闭页签"
                                        AutomationProperties.AutomationId="CloseWorkspaceTab"
                                        Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding Content}" Margin="26,18,26,22" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
