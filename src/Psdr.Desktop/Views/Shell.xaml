                                                        <TextBlock Text="字典维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}" IsChecked="{Binding IsUserActive, Mode=OneWay}" Command="{Binding NavigateUserCommand}" Padding="12,0" Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="用户维护" AutomationProperties.AutomationId="NavigateUserCompact">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource UserManagementIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                                        <TextBlock Text="用户维护" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid Visibility="{Binding HasSettingsAccess, Converter={StaticResource BooleanToVisibility}}">
                                    <ToggleButton x:Name="CompactSettingsButton" Style="{DynamicResource SidebarNavigationStyle}" IsChecked="{Binding IsCompactSettingsMenuOpen, Mode=TwoWay}" ToolTip="系统设置" HorizontalContentAlignment="Center" AutomationProperties.Name="系统设置" AutomationProperties.AutomationId="OpenCompactSettingsMenu">
                                        <Path Data="{StaticResource SettingsIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Width="19" Height="19" Stretch="Uniform" />
                                    </ToggleButton>
                                    <Popup PlacementTarget="{Binding ElementName=CompactSettingsButton}" Placement="Right" HorizontalOffset="8" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsCompactSettingsMenuOpen, Mode=TwoWay}">
                                        <Border Width="202" Padding="8" CornerRadius="8" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SidebarHoverBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="系统设置" Margin="12,7,0,8" Foreground="{DynamicResource SidebarSectionBrush}" FontSize="13" />
                                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}" IsChecked="{Binding IsProductMapActive, Mode=OneWay}" Command="{Binding NavigateProductMapCommand}" Padding="12,0" AutomationProperties.Name="产品属性" AutomationProperties.AutomationId="NavigateProductMapCompact">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource ProductMapIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                                        <TextBlock Text="产品属性" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}" IsChecked="{Binding IsSystemSettingActive, Mode=OneWay}" Command="{Binding NavigateSystemSettingCommand}" Padding="12,0" Visibility="{Binding CanSystemSetting, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="系统设置" AutomationProperties.AutomationId="NavigateSystemSettingCompact">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource BaseDataIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                                        <TextBlock Text="系统设置" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton Style="{DynamicResource SidebarSubNavigationStyle}" IsChecked="{Binding IsOperationLogActive, Mode=OneWay}" Command="{Binding NavigateOperationLogCommand}" Padding="12,0" Visibility="{Binding CanOperationLog, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="操作日志" AutomationProperties.AutomationId="NavigateOperationLogCompact">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource BaseDataIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
                                                        <TextBlock Text="操作日志" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="26,0">
                        <TextBlock Text="{Binding PageTitle}" VerticalAlignment="Center" Style="{DynamicResource PageTitleTextStyle}" />
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ToggleButton x:Name="UserMenuButton" Style="{DynamicResource UserMenuToggleStyle}" IsChecked="{Binding IsUserMenuOpen, Mode=TwoWay}" AutomationProperties.Name="用户信息" AutomationProperties.AutomationId="UserMenu" ToolTip="查看业务用户信息">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentUserName}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                                    <Border Width="34" Height="34" Background="{DynamicResource CanvasBrush}" CornerRadius="17" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding CurrentUserInitial}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>
                            <Popup PlacementTarget="{Binding ElementName=UserMenuButton}" Placement="Bottom" HorizontalOffset="-8" VerticalOffset="8" IsOpen="{Binding IsUserMenuOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                                <Border Width="262" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Text="用户信息" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="业务用户" Margin="0,16,0,3" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding CurrentUserName}" />
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,12" />
                                        <TextBlock Text="账号" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding CurrentUserCode}" Margin="0,3,0,0" />
                                        <TextBlock Text="角色" Margin="0,12,0,3" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding CurrentUserRole}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>
                <TabControl Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" AutomationProperties.AutomationId="WorkspaceTabs" Style="{StaticResource WorkspaceTabControlStyle}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource WorkspaceTabItemStyle}" />
                    </TabControl.ItemContainerStyle>
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                <Button Content="×" Style="{StaticResource WorkspaceTabCloseButtonStyle}" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}" ToolTip="关闭页签" AutomationProperties.AutomationId="CloseWorkspaceTab" Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding Content}" Margin="26,18,26,22" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
