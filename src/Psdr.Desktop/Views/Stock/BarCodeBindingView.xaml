<UserControl x:Class="Psdr.Desktop.Views.Stock.BarCodeBindingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="条码绑定" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="绑定会将一件无条码库存转换为独立条码库存；已售条码不能解绑" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel><Button Grid.Column="1" Content="刷新资料" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/></Grid></Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{DynamicResource ContentCardStyle}" Padding="22"><StackPanel><TextBlock Text="绑定条码" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="仓库 *" Margin="0,20,0,7"/><ComboBox ItemsSource="{Binding StoreHouses}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedStoreHouse}"/><TextBlock Text="产品 *" Margin="0,16,0,7"/><ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="ProductName"/><TextBlock Text="扫描/输入条码 *" Margin="0,16,0,7"/><TextBox Text="{Binding BindCode, UpdateSourceTrigger=PropertyChanged}"/><Button Content="绑定" Command="{Binding BindCommand}" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,22,0,0" HorizontalAlignment="Left"/></StackPanel></Border><Border Grid.Column="2" Style="{DynamicResource ContentCardStyle}" Padding="22"><StackPanel><TextBlock Text="解绑条码" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="仅允许解绑未售出的在库条码" Margin="0,5,0,20" Style="{DynamicResource SecondaryTextStyle}"/><TextBlock Text="扫描/输入条码 *" Margin="0,0,0,7"/><TextBox Text="{Binding UnbindCode, UpdateSourceTrigger=PropertyChanged}"/><Button Content="解绑" Command="{Binding UnbindCommand}" Margin="0,22,0,0" HorizontalAlignment="Left"/><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,28,0,0"/></StackPanel></Border></Grid>
    </Grid>
</UserControl>
