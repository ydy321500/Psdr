<UserControl x:Class="Psdr.Desktop.Views.Stock.BarcodeInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="有码扫码盘点" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="先读取在库条码，再扫描实物；提交后未扫描条码会被移出库存并产生流水。" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel><Button Grid.Column="1" Content="刷新资料" Command="{Binding RefreshSourcesCommand}"/></Grid></Border>
        <Border Grid.Row="2" Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding StoreHouses}" SelectedItem="{Binding SelectedStoreHouse}" DisplayMemberPath="Name"/><ComboBox Grid.Column="2" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="ProductName"/><Button Grid.Column="4" Content="读取在库条码" Command="{Binding LoadCodesCommand}"/><TextBox Grid.Column="6" Text="{Binding ScanCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="扫描或输入条码"/><Button Grid.Column="8" Content="确认扫描" Command="{Binding ScanCommand}" Style="{DynamicResource PrimaryButtonStyle}"/></Grid></Border>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><Border Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="条码" Binding="{Binding BarCode}" Width="*"/><DataGridTextColumn Header="数量" Binding="{Binding Amount}" Width="90"/><DataGridCheckBoxColumn Header="已扫描" Binding="{Binding IsScanned}" Width="90"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/></Grid></Border><Border Grid.Column="2" Style="{DynamicResource ContentCardStyle}" Padding="20"><StackPanel><TextBlock Text="提交盘点" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="{Binding ScannedCount, StringFormat=已扫描：{0}}" Margin="0,18,0,0"/><TextBlock Text="{Binding MissingCount, StringFormat=未扫描：{0}}" Margin="0,6,0,0"/><TextBlock Text="盘点原因 *" Margin="0,18,0,6"/><TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalContentAlignment="Top"/><Button Content="提交扫码盘点" Command="{Binding SubmitCommand}" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border></Grid>
    </Grid>
</UserControl>
