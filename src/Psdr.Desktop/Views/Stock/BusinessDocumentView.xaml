<UserControl x:Class="Psdr.Desktop.Views.Stock.BusinessDocumentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="业务单据" Style="{DynamicResource PageTitleTextStyle}" /><TextBlock Text="统一查询采购入库、销售出库和客户退货单据" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}" /></StackPanel><Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Center" /></Grid></Border>
        <Border Grid.Row="2" Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="150" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="业务类型" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedTextBrush}" /><ComboBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding SelectedDocumentType}" Width="120" /><TextBlock Text="开始日期" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{DynamicResource MutedTextBrush}" /><DatePicker SelectedDate="{Binding StartDate}" Width="132" /><TextBlock Text="结束日期" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{DynamicResource MutedTextBrush}" /><DatePicker SelectedDate="{Binding EndDate}" Width="132" /><TextBlock Text="搜索" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{DynamicResource MutedTextBrush}" /><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="按单号、客户、供应商、仓库、产品类型或备注筛选" /></StackPanel><DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"><DataGrid.Columns><DataGridTextColumn Header="业务" Binding="{Binding DocumentType}" Width="100" /><DataGridTextColumn Header="单号" Binding="{Binding No}" Width="2*" /><DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" /><DataGridTextColumn Header="仓库" Binding="{Binding StoreHouseName}" Width="*" /><DataGridTextColumn Header="仓库编号" Binding="{Binding StoreHouseID}" Width="80" /><DataGridTextColumn Header="往来单位" Binding="{Binding PartnerName}" Width="*" /><DataGridTextColumn Header="产品类型" Binding="{Binding ProductName}" Width="*" /><DataGridTextColumn Header="数量" Binding="{Binding Amount}" Width="70" /><DataGridTextColumn Header="金额" Binding="{Binding TotalMoney, StringFormat=N2}" Width="90" /><DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*" /></DataGrid.Columns></DataGrid><TextBlock Grid.Row="4" Text="单据明细" Style="{DynamicResource PageTitleTextStyle}" /><DataGrid Grid.Row="6" ItemsSource="{Binding Lines}" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"><DataGrid.Columns><DataGridTextColumn Header="产品编号" Binding="{Binding ProductID}" Width="90" /><DataGridTextColumn Header="产品类型" Binding="{Binding ProductType}" Width="*" /><DataGridTextColumn Header="属性 1" Binding="{Binding ProductAttribute1}" Width="*" /><DataGridTextColumn Header="属性 2" Binding="{Binding ProductAttribute2}" Width="*" /><DataGridTextColumn Header="数量" Binding="{Binding Amount}" Width="90" /><DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100" /><DataGridTextColumn Header="条码" Binding="{Binding BarCode}" Width="*" /></DataGrid.Columns></DataGrid><TextBlock Grid.Row="8" Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}" /></Grid></Border>
    </Grid>
</UserControl>
