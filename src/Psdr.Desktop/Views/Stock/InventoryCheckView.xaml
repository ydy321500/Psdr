<UserControl x:Class="Psdr.Desktop.Views.Stock.InventoryCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="库存核对与盘点" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="先比对库存余额与流水余额；只有核实实物后才可提交盘点调整" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel>
                <Button Grid.Column="1" Content="开始核对" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"><DataGrid.Columns><DataGridTextColumn Header="仓库" Binding="{Binding StoreHouseID}" Width="90"/><DataGridTextColumn Header="产品" Binding="{Binding ProductID}" Width="90"/><DataGridTextColumn Header="条码" Binding="{Binding BarCode}" Width="*"/><DataGridTextColumn Header="实时库存" Binding="{Binding StockAmount}" Width="100"/><DataGridTextColumn Header="流水余额" Binding="{Binding LedgerBalance}" Width="100"/><DataGridTextColumn Header="差异" Binding="{Binding Difference}" Width="90"/></DataGrid.Columns></DataGrid>
                <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
            </Grid></Border>
            <Border Grid.Column="2" Style="{DynamicResource ContentCardStyle}" Padding="20"><StackPanel><TextBlock Text="盘点调整" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="选中差异行后输入实际盘点数量。此操作会写入库存与流水，不能直接撤销。" TextWrapping="Wrap" Margin="0,6,0,18" Style="{DynamicResource SecondaryTextStyle}"/><TextBlock Text="实际数量 *"/><TextBox Text="{Binding ActualAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,15"/><TextBlock Text="调整原因 *"/><TextBox Text="{Binding AdjustmentRemark, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalContentAlignment="Top"/><Button Content="确认盘点调整" Command="{Binding AdjustCommand}" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
