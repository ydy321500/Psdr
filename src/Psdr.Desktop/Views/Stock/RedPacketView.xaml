<UserControl x:Class="Psdr.Desktop.Views.Stock.RedPacketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="红包兑换状态" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="查看已售条码是否已申请或完成红包兑换；已兑换条码不能退货。" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel>
                <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{DynamicResource ContentCardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="条码" Binding="{Binding BarCode}" Width="2*"/><DataGridTextColumn Header="产品" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="客户" Binding="{Binding ShopName}" Width="*"/><DataGridTextColumn Header="售出时间" Binding="{Binding SoldAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/><DataGridTextColumn Header="状态" Binding="{Binding StateName}" Width="110"/><DataGridTextColumn Header="红包金额" Binding="{Binding RedeemedMoney}" Width="100"/><DataGridTextColumn Header="兑换时间" Binding="{Binding RedeemedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/></DataGrid.Columns></DataGrid>
            <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}"/>
        </Grid></Border>
    </Grid>
</UserControl>
