<UserControl x:Class="Psdr.Desktop.Views.Stock.SalesOrderReviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="订单审核" Style="{DynamicResource PageTitleTextStyle}"/><TextBlock Text="草稿不会占用库存；审核通过才执行出库、客户应收与条码售出登记。" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}"/></StackPanel><Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/></Grid></Border>
        <Border Grid.Row="2" Style="{DynamicResource ContentCardStyle}" Padding="18"><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="订单号" Binding="{Binding No}" Width="*"/><DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/><DataGridTextColumn Header="仓库" Binding="{Binding StoreHouseName}" Width="120"/><DataGridTextColumn Header="客户" Binding="{Binding ShopName}" Width="160"/><DataGridTextColumn Header="产品" Binding="{Binding ProductName}" Width="140"/><DataGridTextColumn Header="数量" Binding="{Binding Amount}" Width="80"/><DataGridTextColumn Header="货款" Binding="{Binding TotalMoney, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/></DataGrid.Columns></DataGrid></Border>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/><Button Grid.Column="1" Content="作废订单" Command="{Binding VoidCommand}"/><Button Grid.Column="3" Content="审核并出库" Command="{Binding ApproveCommand}" Style="{DynamicResource PrimaryButtonStyle}"/></Grid>
    </Grid>
</UserControl>
