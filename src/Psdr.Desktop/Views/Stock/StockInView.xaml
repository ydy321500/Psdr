<UserControl x:Class="Psdr.Desktop.Views.Stock.StockInView"
             xmlns:dialog="clr-namespace:Psdr.UI.Behaviors;assembly=Psdr.UI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="采购入库" Style="{DynamicResource PageTitleTextStyle}" />
                    <TextBlock Text="保存时同时生成入库单、更新指定仓库的库存余额并记录库存流水" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="刷新资料" Command="{Binding RefreshCommand}" VerticalAlignment="Center" /><Button Content="新增入库单" Margin="8,0,0,0" Style="{DynamicResource PrimaryButtonStyle}" dialog:EditorDialog.Target="{Binding ElementName=EditorPanel}" /></StackPanel>
            </Grid>
        </Border>
        <StackPanel x:Name="EditorPanel" Grid.Row="2" Grid.RowSpan="3" Visibility="Collapsed" dialog:EditorDialog.Title="创建入库单" dialog:EditorDialog.Status="{Binding StatusMessage}" dialog:EditorDialog.SuccessText="入库已保存" dialog:EditorDialog.Width="900"><Border Style="{DynamicResource ContentCardStyle}" Padding="20">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="入库仓库 *" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding StoreHouses}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedStoreHouse}" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="供应商 *" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding Supplies}" DisplayMemberPath="SupplyName" SelectedItem="{Binding SelectedSupply}" /></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="其他费用" Margin="0,0,0,7" /><TextBox Text="{Binding OtherMoney, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            </Grid>
        </Border>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="20" Margin="0,14,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="添加入库明细" Style="{DynamicResource PageTitleTextStyle}" />
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}">
                        <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ProductID}" /><TextBlock Text=" - " /><TextBlock Text="{Binding ProductName}" /><TextBlock Text="  " /><TextBlock Text="{Binding K1}" /><TextBlock Text="  " /><TextBlock Text="{Binding K2}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Grid.Column="2" Text="{Binding LineAmount, UpdateSourceTrigger=PropertyChanged}" ToolTip="数量" />
                    <TextBox Grid.Column="4" Text="{Binding LineUnitPrice, UpdateSourceTrigger=PropertyChanged}" ToolTip="采购单价" />
                    <TextBox Grid.Column="6" Text="{Binding LineBarCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="条码（可选）" />
                    <Button Grid.Column="8" Content="加入明细" Command="{Binding AddLineCommand}" />
                </Grid>
                <DataGrid Grid.Row="4" ItemsSource="{Binding Lines}" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="产品" Binding="{Binding ProductDisplay}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="数量" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="100" />
                        <DataGridTextColumn Header="条码" Binding="{Binding BarCode, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTextColumn Header="金额" Binding="{Binding Total, StringFormat=N2}" Width="100" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="操作" Width="86"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="移除" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="备注" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" Width="320" /></StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding TotalMoney, StringFormat=合计：{0:N2}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Grid.Column="3" Content="保存入库" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                </Grid>
            </Grid>
        </Border></StackPanel>
    </Grid>
</UserControl>
