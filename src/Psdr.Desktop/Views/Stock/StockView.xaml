<UserControl x:Class="Psdr.Desktop.Views.Stock.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="22,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="库存查询" Style="{DynamicResource PageTitleTextStyle}" />
                    <TextBlock Text="库存由入库、销售和退货业务自动变更，此页面仅供查询" Margin="0,5,0,0" Style="{DynamicResource SecondaryTextStyle}" /></StackPanel>
                <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{DynamicResource ContentCardStyle}" Padding="20">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"><TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" ToolTip="按产品、条码或库位筛选" /></StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编号" Binding="{Binding StockID}" Width="90" /><DataGridTextColumn Header="仓库" Binding="{Binding StoreHouseName}" Width="*" /><DataGridTextColumn Header="产品编号" Binding="{Binding ProductID}" Width="90" />
                        <DataGridTextColumn Header="产品类型" Binding="{Binding ProductType}" Width="*" /><DataGridTextColumn Header="属性 1" Binding="{Binding ProductAttribute1}" Width="*" />
                        <DataGridTextColumn Header="属性 2" Binding="{Binding ProductAttribute2}" Width="*" /><DataGridTextColumn Header="条码" Binding="{Binding BarCode}" Width="*" />
                        <DataGridTextColumn Header="库位" Binding="{Binding Position}" Width="*" /><DataGridTextColumn Header="数量" Binding="{Binding Amount}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{DynamicResource ContentCardStyle}" Padding="20">
            <StackPanel><TextBlock Text="最近库存流水" Style="{DynamicResource PageTitleTextStyle}" Margin="0,0,0,12" />
                <DataGrid ItemsSource="{Binding LedgerItems}" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="260">
                    <DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding OccurredAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="*" /><DataGridTextColumn Header="业务类型" Binding="{Binding BusinessType}" Width="*" /><DataGridTextColumn Header="单号" Binding="{Binding BusinessNo}" Width="2*" /><DataGridTextColumn Header="仓库" Binding="{Binding StoreHouseID}" Width="80" /><DataGridTextColumn Header="产品" Binding="{Binding ProductID}" Width="80" /><DataGridTextColumn Header="变动" Binding="{Binding ChangeAmount}" Width="80" /><DataGridTextColumn Header="变动后" Binding="{Binding BalanceAfter}" Width="80" /></DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border></Grid>
    </Grid>
</UserControl>
