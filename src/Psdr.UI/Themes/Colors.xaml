<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryHoverColor">#1D4ED8</Color>
    <Color x:Key="CanvasColor">#F5F7FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="TextColor">#172033</Color>
    <Color x:Key="MutedTextColor">#64748B</Color>
    <Color x:Key="SidebarColor">#111B30</Color>
    <Color x:Key="SidebarHoverColor">#1D2D4A</Color>
    <Color x:Key="SidebarMutedColor">#A9B7D1</Color>
    <Color x:Key="SidebarSectionColor">#8494B4</Color>
    <Color x:Key="DialogHeaderColor">#2D4864</Color>
    <Color x:Key="DialogOutlineColor">#B8CADB</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="{StaticResource SidebarMutedColor}" />
    <SolidColorBrush x:Key="SidebarSectionBrush" Color="{StaticResource SidebarSectionColor}" />
    <SolidColorBrush x:Key="DialogHeaderBrush" Color="{StaticResource DialogHeaderColor}" />
    <SolidColorBrush x:Key="DialogOutlineBrush" Color="{StaticResource DialogOutlineColor}" />
    <SolidColorBrush x:Key="DashboardBlueBrush" Color="#399AF2" />
    <SolidColorBrush x:Key="DashboardCyanBrush" Color="#29BFC5" />
    <SolidColorBrush x:Key="DashboardPurpleBrush" Color="#8A77E6" />
    <SolidColorBrush x:Key="DashboardCoralBrush" Color="#F26E79" />
    <SolidColorBrush x:Key="DashboardBlueTintBrush" Color="#EAF5FF" />
    <SolidColorBrush x:Key="DashboardCyanTintBrush" Color="#E9F9F9" />
    <SolidColorBrush x:Key="DashboardPurpleTintBrush" Color="#F1EEFF" />
    <SolidColorBrush x:Key="DashboardCoralTintBrush" Color="#FFF0F2" />
    <LinearGradientBrush x:Key="LoginBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#29435E" Offset="0" />
        <GradientStop Color="#365A7C" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
